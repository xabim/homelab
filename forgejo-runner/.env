# Forgejo runner - non-secret settings (no secrets: registration lives in the data dir)

RUNNER_VERSION=13.2.0
# Must match the projects' @playwright/test version (browser tests in CI)
PLAYWRIGHT_VERSION=1.64.1

# Repeated from ../.env.global because `user:` is interpolated from this file only
PUID=1000
PGID=1000

CI_MEM_LIMIT=3g
CI_CPUS=2.0

[Unit]
Description=Homelab nightly backup (NVMe -> plain files on ZFS)
After=docker.service zfs-mount.service
Requires=zfs-mount.service

[Service]
Type=oneshot
# The host is often off at 03:30: the timer then fires right after boot. Wait until the
# stacks are up, or a starting database would be copied as files instead of dumped.
ExecStartPre=/bin/sh -c 'while [ "$(cut -d. -f1 /proc/uptime)" -lt 900 ]; do sleep 30; done'
TimeoutStartSec=infinity
ExecStart=/srv/docker/stacks/scripts/backup.sh run
Nice=10
IOSchedulingClass=idle

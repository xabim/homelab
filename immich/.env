# Versión: en docs se ve IMMICH_VERSION=v2 como ejemplo.
# Puedes pinnear a una versión exacta tipo v2.3.1 si quieres.
IMMICH_VERSION=release

# Datos (ZFS)
UPLOAD_LOCATION=/srv/data/immich/library
DB_DATA_LOCATION=/srv/docker/volumes/immich/postgres

# DB credenciales (password en /srv/docker/secrets/immich_db_password)
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
# Immich paths
IMMICH_DATA_DIR=/srv/data/immich/data
IMMICH_ML_CACHE_VOL=/srv/docker/volumes/immich/ml-cache
# Note: UPLOAD_LOCATION and DB_DATA_LOCATION are already defined in .env

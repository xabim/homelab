# --- Domains ---
NC_DOMAIN=cloud.home
OO_DOMAIN=office.home

# --- Traefik ---
TRAEFIK_NETWORK=proxy
TRAEFIK_CERTRESOLVER=stepca

# --- Paths ---
NC_DATA_DIR=/srv/data/nextcloud

NC_APP_VOL=/srv/docker/volumes/nextcloud/app
NC_DB_VOL=/srv/docker/volumes/nextcloud/db
NC_REDIS_VOL=/srv/docker/volumes/nextcloud/redis

OO_DATA_VOL=/srv/docker/volumes/onlyoffice/data
OO_LOGS_VOL=/srv/docker/volumes/onlyoffice/logs
OO_LIB_VOL=/srv/docker/volumes/onlyoffice/lib
OO_FONTS_VOL=/srv/docker/volumes/onlyoffice/fonts

# --- Postgres ---
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
# Password in /srv/docker/secrets/nextcloud_db_password

# --- Nextcloud admin (first run only) ---
NC_ADMIN_USER=admin
# Password in .env.secrets

# --- Nextcloud config ---
NEXTCLOUD_TRUSTED_DOMAINS=cloud.home

# --- OnlyOffice JWT ---
JWT_ENABLED=true
# Secret in .env.secrets
# Nextcloud paths
# Step CA root certificate for internal HTTPS services
STEP_CA_ROOT_CA=/srv/docker/volumes/step-ca/certs/root_ca.crt
# Note: NC_DB_VOL, NC_REDIS_VOL, NC_APP_VOL, NC_DATA_DIR are already defined in .env

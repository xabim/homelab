DOCKER_SOCKET_PROXY_VERSION=v0.5.0

# Docker Socket Proxy Configuration
LOG_LEVEL=info

# Allowed operations
CONTAINERS=1
EVENTS=1
NETWORKS=1
INFO=1
PING=1
VERSION=1
STATS=1
GET=1
IMAGES=1
VOLUMES=1

# Explicitly deny everything else
SERVICES=0
TASKS=0
EXEC=0
BUILD=0

# Explicitly deny write methods
POST=0
PUT=0
DELETE=0

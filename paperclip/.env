# Paperclip stack - non-secret settings (secrets: .env.secrets, see .env.secrets.example)

# Pinned upstream image (ghcr.io/paperclipai/paperclip:<tag>). Change only via
# the upgrade procedure in README.md (rebuild + backup first).
PAPERCLIP_VERSION=sha-d69631b01b9c658f80bf8bed389863dce82643e1
# Headless Chromium for agents' browser tests (baked into the derived image)
PLAYWRIGHT_VERSION=1.64.1

# Run as this host user (owner of /srv/docker/volumes/paperclip). Repeated
# from ../.env.global because `user:` is interpolated from this file only.
PUID=1000
PGID=1000

PAPERCLIP_HOSTNAME=paperclip.home
FORGEJO_HOSTNAME=forgejo.home

# Larger than the resource-limits.yaml tiers: agent runs execute inside the
# Paperclip container next to the embedded PostgreSQL.
PAPERCLIP_MEM_LIMIT=4g
PAPERCLIP_CPUS=4.0

# Claude Code git deny rules mounted for every agent run:
#   review = no commit/push  |  commit = local commits only  |  push = feature-branch pushes
AGENT_GIT_POLICY=push

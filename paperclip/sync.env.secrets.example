# Template for /srv/docker/stacks/paperclip/sync.env.secrets  (gitignored, mode 600)
#
#   install -m 600 /dev/null /srv/docker/stacks/paperclip/sync.env.secrets
#
# Read only by the studio-sync container. Keep these out of .env.secrets: that
# file is the environment of the container the agents run in.
# Never commit real values. Recreate studio-sync after editing.

# --- Paperclip: the owner's board key, as a full HTTP header line --------------
# The same line as ~/.config/ai-studio/paperclip.hdr on the owner's machine
# (`studio login`). It closes issues at the owner's approval stage.
PAPERCLIP_AUTH_HEADER=
# Company (organization) whose issues are synced: `studio agents` or the URL.
PAPERCLIP_COMPANY_ID=

# --- Forgejo: the studio-sync account -----------------------------------------
# A dedicated account in the agents team (write on code and pulls), token
# scopes: write:repository read:organization read:user. It updates approved
# branches with main; it cannot approve (not on the approvals whitelist).
FORGEJO_SYNC_TOKEN=
# Organization that holds the project repositories.
FORGEJO_ORG=studio
# The owner's Forgejo login: only this account's "request changes" counts.
FORGEJO_OWNER_USER=

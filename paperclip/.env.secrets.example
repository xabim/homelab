# =============================================================================
# Template for /srv/docker/stacks/paperclip/.env.secrets  (gitignored, mode 600)
#
#   install -m 600 /dev/null /srv/docker/stacks/paperclip/.env.secrets
#
# Never commit real values. Redeploy the stack after editing.
# =============================================================================

# --- Paperclip signing secrets (openssl rand -hex 32, independent values) ----
# Keep stable: rotating BETTER_AUTH_SECRET signs everyone out; rotate the
# tool-action secret only when no approvals are pending.
BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# --- Claude Code subscription token ------------------------------------------
# `claude setup-token` on a machine with a browser. Billed against the Claude
# subscription. NEVER add ANTHROPIC_API_KEY: it takes precedence and switches
# every run to pay-as-you-go API billing.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Forgejo bot account for agents' git over HTTPS ---------------------------
# Token scope: read:repository (AGENT_GIT_POLICY review|commit) or
# write:repository (push). Protect `main` with Forgejo branch protection.
FORGEJO_BOT_USER=
FORGEJO_BOT_TOKEN=

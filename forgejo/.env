# Forgejo Configuration
USER_UID=1000
USER_GID=1000
RUN_MODE=prod

# Database Configuration
DB_TYPE=postgres
DB_HOST=db:5432
DB_NAME=forgejo
DB_USER=forgejo

# PostgreSQL Configuration
POSTGRES_USER=forgejo
POSTGRES_DB=forgejo
# Forgejo paths
FORGEJO_DATA_DIR=/srv/data/forgejo
FORGEJO_DB_VOL=/srv/docker/volumes/forgejo/postgres

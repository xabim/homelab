# Traefik CA certificates
LEGO_CA_CERTIFICATES=/usr/local/share/ca-certificates/step-root-ca.crt
# Traefik paths
TRAEFIK_CONFIG_FILE=/srv/docker/volumes/traefik/traefik.yml
TRAEFIK_CERTS_VOL=/srv/docker/volumes/traefik/certs
TRAEFIK_DYNAMIC_VOL=/srv/docker/volumes/traefik/dynamic
TRAEFIK_ROOT_CA=/srv/docker/volumes/traefik/root_ca.crt

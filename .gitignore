# =============================================================================
# Secrets and Sensitive Data
# =============================================================================

# Environment files with secrets
*.env.secrets
.env.secrets
.secrets

# All .env files (uncomment if you want to exclude all env files)
# *.env
# .env
# .env.*

# Specific environment files that may contain secrets
**/.env.local
**/.env.production

# =============================================================================
# Certificates and Keys
# =============================================================================

# Private keys and certificates
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
!root_ca.crt

# SSH keys
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.pub

# =============================================================================

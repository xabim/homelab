REDIS_VERSION=8
POSTGRES_VERSION=18
PAPERLESS_VERSION=3.3.4

# ------------------------
# Storage layout
# ------------------------

# ZFS tank (datos grandes)
PAPERLESS_MEDIA=/srv/data/paperless/media
PAPERLESS_CONSUME=/srv/data/paperless/consume
PAPERLESS_EXPORT=/srv/data/paperless/export

# NVMe (IOPS / latencia)
PAPERLESS_POSTGRES_DATA=/srv/docker/volumes/paperless/postgres
PAPERLESS_REDIS_DATA=/srv/docker/volumes/paperless/redis

# NVMe – app internal data (cache, index, thumbnails)
PAPERLESS_APP_DATA=/srv/docker/volumes/paperless/data

# ------------------------
# Paperless configuration
# ------------------------
PAPERLESS_REDIS=redis://broker:6379
PAPERLESS_DBHOST=db
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_TIME_ZONE=Europe/Madrid
PAPERLESS_URL=https://paperless.home
PAPERLESS_ALLOWED_HOSTS=paperless.home,192.168.1.101
PAPERLESS_OCR_LANGUAGE=spa

# ------------------------
# v3 settings (keep v2 behaviour)
# ------------------------
PAPERLESS_DBENGINE=postgresql
# v3 accepts duplicates by default; keep rejecting them
PAPERLESS_CONSUMER_DELETE_DUPLICATES=true
# v3 default "auto" skips archives for born-digital PDFs; keep always creating them
PAPERLESS_ARCHIVE_FILE_GENERATION=always
# Only reachable through Traefik (one X-Forwarded-For hop) - needed for login rate limiting
PAPERLESS_ALLAUTH_TRUSTED_PROXY_COUNT=1
